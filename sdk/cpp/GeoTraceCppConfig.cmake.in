# GeoTraceCppConfig.cmake — generated by cmake --install
# Provides the GeoTrace::Cpp imported target.

set(GEOTRACE_CPP_VERSION "@PROJECT_VERSION@")

get_filename_component(_gtcpp_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

# The C++ SDK depends on the C SDK.
find_package(GeoTraceC REQUIRED HINTS "${_gtcpp_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/GeoTraceC")

add_library(GeoTrace::Cpp INTERFACE IMPORTED)
set_target_properties(GeoTrace::Cpp PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_gtcpp_prefix}/@CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_LINK_LIBRARIES GeoTrace::C
    INTERFACE_COMPILE_FEATURES cxx_std_17
)

set(GeoTraceCpp_FOUND TRUE)
