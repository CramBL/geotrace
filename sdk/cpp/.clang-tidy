# google-runtime-int is the one check enabled from the google- family. It
# reports a `short`, `long` or `long long` declaration in a C++ translation
# unit. The C sources have `qa::check-fixed-width-integers` for the same rule.
Checks: "clang-analyzer-*,bugprone-*,cert-*,cppcoreguidelines-*,google-runtime-int,hicpp-*,\
  misc-*,modernize-*,performance-*,portability-*,readability-*,\
  -clang-analyzer-cplusplus.NewDeleteLeaks,\
  -clang-diagnostic-c++20-designator,\
  -modernize-use-trailing-return-type"
WarningsAsErrors: "*"
HeaderFilterRegex: "sdk/cpp/.*\\.hpp"
CheckOptions:
  # The plain aggregates the SDK returns hold public members only. The check
  # reports a class that mixes public data with private members.
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  readability-identifier-length.MinimumLoopCounterNameLength: 1
  # A caught exception and the two sides of a comparison operator.
  readability-identifier-length.IgnoredVariableNames: "^e$"
  readability-identifier-length.IgnoredParameterNames: "^[ab]$"
  # The preprocessor reads the version and exception-support macros.
  cppcoreguidelines-macro-usage.AllowedRegexp: "^GEOTRACE_CPP_"
