Checks: "clang-analyzer-*,bugprone-*,cert-*,misc-*,performance-*,portability-*,readability-*,\
  -readability-magic-numbers"
WarningsAsErrors: "*"
HeaderFilterRegex: "sdk/c/.*\\.h"
# sdk/c/geotrace.h is generated by cbindgen (sdk/rust/geotrace-c/cbindgen.toml).
# Its declarations come from the Rust source. scripts/lint-c.sh skips it for
# clang-format on the same grounds.
ExcludeHeaderFilterRegex: "geotrace\\.h$"
CheckOptions:
  readability-identifier-length.MinimumLoopCounterNameLength: 1
  # The default list includes every stdio call, `fprintf` among them. These are
  # the file, conversion and formatting calls whose result an example checks or
  # discards with a `(void)` cast.
  cert-err33-c.CheckedFunctions: "^::remove$;^::fclose$;^::fopen$;^::fread$;^::fwrite$;\
    ^::snprintf$;^::strtod$;^::strtol$;^::strtoul$;^::strtoll$;^::strtoull$"
