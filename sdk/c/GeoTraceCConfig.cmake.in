# GeoTraceCConfig.cmake — generated by cmake --install
# Provides the GeoTrace::C imported target.

@PACKAGE_INIT@

# Whether the installed library is static (.a / .lib); baked in at install time.
set(_geotrace_c_static @_gtc_config_static@)

# Prefer the matching library type when both static and shared exist.
if(_geotrace_c_static)
    set(_gtc_saved_suffixes "${CMAKE_FIND_LIBRARY_SUFFIXES}")
    if(WIN32)
        set(CMAKE_FIND_LIBRARY_SUFFIXES ".lib")
    else()
        set(CMAKE_FIND_LIBRARY_SUFFIXES ".a")
    endif()
endif()

find_library(GEOTRACE_C_LIBRARY
    NAMES geotrace_c
    HINTS "@PACKAGE_CMAKE_INSTALL_LIBDIR@"
    NO_DEFAULT_PATH
)

if(_geotrace_c_static)
    set(CMAKE_FIND_LIBRARY_SUFFIXES "${_gtc_saved_suffixes}")
endif()

if(NOT GEOTRACE_C_LIBRARY)
    set(GeoTraceC_FOUND FALSE)
    return()
endif()

if(_geotrace_c_static)
    add_library(GeoTrace::C STATIC IMPORTED)
else()
    add_library(GeoTrace::C SHARED IMPORTED)
endif()

set(_geotrace_c_iface_libs "")
if(_geotrace_c_static)
    if(UNIX AND NOT APPLE)
        # Rust's archive on Linux depends on these system libraries.
        list(APPEND _geotrace_c_iface_libs m dl pthread)
    elseif(WIN32)
        # Rust's archive on Windows uses NT I/O and Win32 APIs not auto-linked by MSVC.
        list(APPEND _geotrace_c_iface_libs ntdll userenv ws2_32 advapi32 bcrypt)
    endif()
endif()

set_target_properties(GeoTrace::C PROPERTIES
    IMPORTED_LOCATION "${GEOTRACE_C_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_LINK_LIBRARIES "${_geotrace_c_iface_libs}"
)

set(GeoTraceC_FOUND TRUE)
