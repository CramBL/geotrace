# GeoTraceCConfig.cmake — generated by cmake --install
# Provides the GeoTrace::C imported target.

@PACKAGE_INIT@

find_library(GEOTRACE_C_LIBRARY
    NAMES geotrace_c
    HINTS "@PACKAGE_CMAKE_INSTALL_LIBDIR@"
    NO_DEFAULT_PATH
)

if(NOT GEOTRACE_C_LIBRARY)
    set(GeoTraceC_FOUND FALSE)
    return()
endif()

# On Windows we install and link against the static library.
if(WIN32)
    add_library(GeoTrace::C STATIC IMPORTED)
else()
    add_library(GeoTrace::C SHARED IMPORTED)
endif()

set_target_properties(GeoTrace::C PROPERTIES
    IMPORTED_LOCATION "${GEOTRACE_C_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@"
)

set(GeoTraceC_FOUND TRUE)
