/target
.pup
tests/tmp/
tests/snapshots/*.diff.png
tests/snapshots/*.old.png
# egui_kittest writes these next to any snapshot baseline on failure, including
# the per-crate test dirs, so ignore them everywhere - only the baseline .png is tracked.
**/tests/snapshots/*.diff.png
**/tests/snapshots/*.old.png
**/tests/snapshots/*.new.png

# Python SDK (geotrace-py)
sdk/python/geotrace-py/.venv/
sdk/python/geotrace-py/target/
sdk/python/geotrace-py/dist/
__pycache__/
*.pyc
*.pyo
sdk/python/geotrace-py/.pytest_cache/
sdk/python/geotrace-py/**/*.egg-info/
# Compiled extension modules produced by maturin (all platforms)
sdk/python/geotrace-py/**/*.so
sdk/python/geotrace-py/**/*.pyd

# Build directories
build/
sdk/c/build/
sdk/cpp/build/

# CMake artifacts
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Just is becoming GNU Make here because the podman/docker caching is painfully slow
.just-cache
